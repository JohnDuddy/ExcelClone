# Dependency licence texts are regenerated by tools/collect_licenses.py.
# The GNU texts are vendored because no wheel ships them and Qt cannot be
# distributed without them, so they are tracked deliberately.
licenses/*
!licenses/LGPL-3.0.txt
!licenses/GPL-3.0.txt
!licenses/README.md


